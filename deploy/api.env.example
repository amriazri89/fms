# /etc/fms/api.env — production settings for FMS (owner root:deploy, mode 640)
# server-setup.sh copies this file and fills in every CHANGE_ME value automatically.
# Double underscore (__) = nested key, e.g. Jwt__Key -> appsettings "Jwt": { "Key" }
# After editing: sudo systemctl restart fms-api

ConnectionStrings__Default=Server=localhost;Port=3306;Database=fms;User=fms;Password=CHANGE_ME_DB_PASSWORD;
Jwt__Key=CHANGE_ME_JWT_KEY

# First-login passwords for "pengurus" and "kerani" (only used when the DB is empty).
# Change them in the app after the first login.
App__ManagerPassword=CHANGE_ME_MANAGER_PASSWORD
App__ClerkPassword=CHANGE_ME_CLERK_PASSWORD

App__CompanyName=Ajib Business
App__TimeZone=Asia/Kuala_Lumpur
Documents__DefaultTaxRate=0
